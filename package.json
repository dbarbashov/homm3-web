{
  "name": "homm3-web",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/engine-client.py build",
    "engine:install": "python3 scripts/engine-client.py install",
    "start": "node scripts/start-site.mjs",
    "start:assets": "node server.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p test_*.py",
    "test:site": "python3 scripts/site-browser-smoke.py && python3 scripts/local-assets-browser-smoke.py",
    "test:mobile": "python3 scripts/mobile-browser-smoke.py && BROWSER=chromium python3 scripts/mobile-browser-smoke.py"
  },
  "description": "Public Heroes III browser shell; consumes a pinned public engine build",
  "license": "MIT"
}
